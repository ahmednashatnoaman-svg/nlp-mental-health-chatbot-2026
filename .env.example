# ── Groq API ────────────────────────────────────────────────────────────────────
# Get free key from: https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here

# ── Qdrant Cloud ────────────────────────────────────────────────────────────────
# Get free cluster from: https://cloud.qdrant.io
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# ── Model Paths (optional override) ─────────────────────────────────────────────
LANGUAGE_MODEL_PATH=models/language_detector.pkl
EMOTION_MODEL_PATH=models/emotion_distilbert
